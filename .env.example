# CubingHQ AI Coach — server-side configuration.
# Set these in the Vercel project settings, not in a committed file.
# The real .env is gitignored; a key was committed here once already and
# had to be rotated, so treat this file as documentation only.
#
# NOTE: Vercel reads environment variables at build/boot. After adding or
# changing any of these you must REDEPLOY — an existing deployment will
# not pick them up, which looks exactly like the variable not working.

# --- Which model provider --------------------------------------------
# anthropic | openrouter | gemini
# If left unset it is inferred from whichever API key is present. With
# several keys present the server logs which one it picked — set this
# explicitly so the bill lands where you intend.
COACH_PROVIDER=gemini

# --- Option A: Gemini ------------------------------------------------
# The only provider that can analyse solve videos. Key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Verify the name at https://ai.google.dev/gemini-api/docs/models
# COACH_MODEL=gemini-2.5-flash
#
# Video is the token-expensive path and may deserve a different model.
# Falls back to COACH_MODEL when unset.
# COACH_VIDEO_MODEL=
#
# Largest video we will accept. Not a Gemini limit — a product one: a
# single solve does not need a 10-minute 4K clip, and video costs a lot
# of tokens. Default 200MB.
# COACH_MAX_VIDEO_BYTES=209715200
#
# NOTE ON FREE TIER: Gemini's free quota is per PROJECT, shared by every
# visitor to the site — not per user. Video will exhaust it far sooner
# than chat does.

# --- Option B: OpenRouter --------------------------------------------
# One API, many models, including free ones. Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
#
# REQUIRED for this provider — there is no default, because OpenRouter's
# catalogue changes and a stale guess here would fail confusingly months
# from now. Copy an exact slug from https://openrouter.ai/models
#
# Comma-separate several to enable fallback routing: the first is the
# model of record, and OpenRouter moves down the list when one cannot
# serve the request. Strongly recommended on free models, whose shared
# endpoints are regularly at capacity — that arrives as a 429 and would
# otherwise be an error the user sees.
#
#   COACH_MODEL=vendor/model-a:free, vendor/model-b:free, vendor/model-c:free
#
# Free models are rate limited per ACCOUNT, not per user — every visitor
# to the site draws on one shared allowance. Fallbacks widen the pool but
# do not remove that ceiling.
COACH_MODEL=

# --- Option C: Anthropic ---------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# COACH_MODEL=claude-opus-5

# --- Model tuning (both providers) ------------------------------------
# COACH_EFFORT=high          # low | medium | high | xhigh | max  (Anthropic)
# COACH_MAX_TOKENS=16000
#
# OpenRouter only. Reasoning models accept an effort hint; sending it to
# a model that does not support it can leave no provider able to serve
# the request, so it is off unless you set it.
# COACH_REASONING_EFFORT=medium
#
# Stops short of the 300s function ceiling in vercel.json so a slow model
# surfaces as a clean timeout instead of a killed function.
# COACH_TIMEOUT_MS=240000
#
# Pause before the single retry of a transient failure (429 / 5xx /
# network). Only those are retried; a spent allowance, a bad key or a
# bad model slug are not, since an identical retry cannot fix them.
# COACH_RETRY_DELAY_MS=1200
#
# Sent to OpenRouter for dashboard attribution only.
# COACH_SITE_URL=https://www.cubinghq.online

# --- Firebase Realtime Database --------------------------------------
# Optional. Without both of these the Coach still works fully; coaching
# data just stays on the user's device instead of syncing.
#
# The Coach's data lives under /coach/<uid> and is written ONLY by these
# serverless functions. The browser never touches that subtree.
FIREBASE_DB_URL=https://simulatecubing-default-rtdb.firebaseio.com
#
# A legacy database secret (Firebase console → Project settings →
# Service accounts → Database secrets). Chosen because it needs no
# dependencies; a service-account JWT is the long-term replacement.
FIREBASE_DB_SECRET=

# IMPORTANT — this is only half the job. The secret lets the server
# bypass database rules; it does not by itself make anything private.
# Add this to the Realtime Database rules BEFORE setting the secret above,
# or /coach stays world-readable like the rest of the database:
#
#   "coach": { ".read": false, ".write": false }
