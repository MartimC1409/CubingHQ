# Build scaffolding for the local test suites: a symlink to the `cubing`
# package so the browser can import kpuzzle/puzzles/twisty over http without
# reaching a CDN. It points outside the repo and must never be committed —
# deleting it by hand before every commit is what broke a test run once.
_pkg_test
_pkg_*

# Local static server logs
http.log

# Secrets. .env was tracked until the AdSense cleanup; the key that was in it
# is in git history and has to be rotated, not just removed.
.env
.env.*
!.env.example

# There is a package.json now, but only so Vercel can install dependencies
# for the /api serverless functions. The site itself is still static with no
# build step, and a static host serves whatever is committed — so installed
# packages must never be.
node_modules/

# Written and removed by scripts/test_coach_api.js to stand in for the
# Anthropic SDK when testing server logic in a bare checkout.
scripts/_stub_anthropic.js
